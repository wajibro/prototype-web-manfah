<%- include('partials/mainHeader', {
  bgImage: "https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/photo-1517420704952-d9f39e95b43e.avif"
}); %>

<%
  const isSuccess = typeof success !== 'undefined' && success;
  const savedShipping = (typeof shipping !== 'undefined' && shipping) ? shipping : null;
%>

<main>
  <section class="relative overflow-hidden h-[220px] lg:h-[260px] flex items-center justify-center">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 text-center text-white px-4">
      <p class="text-xs lg:text-base font-medium tracking-wider uppercase text-white/90">
        <a href="/" class="text-white/50 hover:text-white/90">Home</a> / Cart
      </p>
      <h1 class="mt-2 text-4xl lg:text-5xl font-bold text-white">Keranjang</h1>
    </div>
  </section>

  <div class="bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

      <% if (isSuccess) { %>
        <div class="mb-8 rounded-2xl border border-green-200 bg-green-50 p-6 text-center">
          <h2 class="text-xl font-bold text-green-700">Pembayaran Berhasil 🎉</h2>
          <p class="mt-2 text-sm text-green-600">
            Terima kasih! Pesanan kamu sedang diproses.
            <% if (order && order.order_id) { %>Order ID: <strong><%= order.order_id %></strong><% } %>
          </p>
          <a href="/product" class="mt-4 inline-block rounded-lg bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition">
            Lanjut Belanja
          </a>
        </div>
      <% } %>

      <% if (!items || items.length === 0) { %>
        <% if (!isSuccess) { %>
          <div class="text-center py-20">
            <p class="text-gray-500 text-lg">Keranjang kamu masih kosong.</p>
            <a href="/products" class="mt-6 inline-block rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primarydark transition">
              Mulai Belanja
            </a>
          </div>
        <% } %>
      <% } else { %>

        <div class="grid lg:grid-cols-3 gap-8">

          <div class="lg:col-span-2 space-y-6">

            <div class="space-y-4">
              <% items.forEach(function(item) { %>
                <div class="cart-row flex items-center gap-4 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm"
                    data-id="<%= item.id_product %>"
                    data-price="<%= item.price %>"
                    data-stock="<%= item.stock %>">

                  <a href="/products/<%= item.slug %>" class="shrink-0 w-20 h-20 rounded-xl bg-softer overflow-hidden">
                    <% if (item.image_url) { %>
                      <img src="<%= item.image_url %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">No Image</div>
                    <% } %>
                  </a>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm lg:text-base font-semibold text-ink truncate"><%= item.name %></h3>
                    <p class="mt-1 text-sm text-primary font-bold">
                      Rp <%= Number(item.price).toLocaleString('id-ID') %>
                    </p>
                    <% if (!item.available) { %>
                      <p class="mt-1 text-xs text-red-500 font-medium">Stok tidak cukup (tersedia: <%= item.stock %>)</p>
                    <% } %>
                  </div>

                  <div class="flex items-center gap-1">
                    <button type="button" class="qty-btn w-9 h-9 rounded-lg bg-gray-100 hover:bg-gray-200 text-lg font-bold text-ink transition" data-action="dec">−</button>
                    <input type="number"
                          class="qty-input w-14 h-9 rounded-lg border border-gray-200 text-center text-sm focus:outline-none focus:ring-2 focus:ring-primary/40"
                          value="<%= item.quantity %>"
                          min="1"
                          max="<%= item.stock %>"
                          data-original="<%= item.quantity %>">
                    <button type="button" class="qty-btn w-9 h-9 rounded-lg bg-gray-100 hover:bg-gray-200 text-lg font-bold text-ink transition" data-action="inc">+</button>
                  </div>

                  <div class="hidden sm:block w-28 text-right">
                    <p class="subtotal text-sm font-bold text-ink">
                      Rp <%= Number(item.subtotal).toLocaleString('id-ID') %>
                    </p>
                  </div>

                  <button type="button"
                          class="remove-btn w-10 h-10 rounded-full text-red-500 hover:bg-red-50 transition flex items-center justify-center"
                          aria-label="Hapus">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/>
                    </svg>
                  </button>
                </div>
              <% }); %>
            </div>

            <!-- ===== FORM PENERIMA ===== -->
            <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <h2 class="text-lg font-bold text-ink mb-4">Data Penerima</h2>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-body mb-1">Nama Penerima *</label>
                  <input type="text" id="recipient_name" required
                         value="<%= savedShipping ? savedShipping.recipient_name : '' %>"
                         class="w-full h-11 rounded-lg border border-gray-200 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                </div>

                <div>
                  <label class="block text-xs font-semibold text-body mb-1">No. Telepon *</label>
                  <input type="tel" id="phone" required
                         value="<%= savedShipping ? savedShipping.phone : '' %>"
                         class="w-full h-11 rounded-lg border border-gray-200 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-semibold text-body mb-1">Email</label>
                  <input type="email" id="email"
                         value="<%= savedShipping ? savedShipping.email : '' %>"
                         class="w-full h-11 rounded-lg border border-gray-200 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-semibold text-body mb-1">Alamat Jalan *</label>
                  <textarea id="address" rows="2" required
                            class="w-full rounded-lg border border-gray-200 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40"><%= savedShipping ? savedShipping.address : '' %></textarea>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-body mb-1">Provinsi *</label>
                  <select id="province" required
                          data-saved="<%= savedShipping ? savedShipping.province_id : '' %>"
                          class="w-full h-11 rounded-lg border border-gray-200 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                    <option value="">Memuat provinsi...</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-body mb-1">Kota/Kabupaten *</label>
                  <select id="city" required
                          data-saved="<%= savedShipping ? savedShipping.city_id : '' %>"
                          class="w-full h-11 rounded-lg border border-gray-200 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                    <option value="">Pilih Kota</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-body mb-1">Kecamatan *</label>
                  <select id="district" required
                          data-saved="<%= savedShipping ? savedShipping.district_id : '' %>"
                          class="w-full h-11 rounded-lg border border-gray-200 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                    <option value="">Pilih Kecamatan</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-body mb-1">Kode Pos</label>
                  <input type="text" id="postal_code"
                         value="<%= savedShipping ? savedShipping.postal_code : '' %>"
                         class="w-full h-11 rounded-lg border border-gray-200 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
                </div>
              </div>

              <button type="button" id="btnCekOngkir"
                      class="mt-4 w-full h-11 rounded-xl bg-gray-100 text-ink font-bold hover:bg-gray-200 transition disabled:opacity-60">
                CEK ONGKIR SEMUA KURIR
              </button>

              <div id="shippingResult" class="mt-6 hidden">
                <div class="flex items-center justify-between mb-3">
                  <label class="text-sm font-semibold text-ink">Pilih Layanan Pengiriman</label>
                  <span class="text-xs text-body">
                    Total berat: <strong id="totalWeightLabel">0</strong> gr
                  </span>
                </div>

                <div id="shippingList" class="space-y-2 max-h-[420px] overflow-y-auto pr-1"></div>

                <div class="mt-4 p-3 rounded-lg bg-primary/5 border border-primary/20 flex justify-between items-center">
                  <span class="text-sm text-body">Ongkir terpilih</span>
                  <strong id="shippingCostLabel" class="text-primary">Rp 0</strong>
                </div>
              </div>
            </section>
          </div>

          <div class="lg:col-span-1">
            <div class="sticky top-24 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <h2 class="text-lg font-bold text-ink">Ringkasan</h2>

              <div class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-body">Total Item</span>
                  <span class="font-semibold" id="summaryTotalItems"><%= totalItems %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-body">Subtotal</span>
                  <span class="font-semibold" id="summarySubtotal">Rp <%= Number(totalPrice).toLocaleString('id-ID') %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-body">Ongkir</span>
                  <span class="font-semibold" id="summaryShipping">Rp 0</span>
                </div>
                <div class="border-t pt-3 flex justify-between text-base">
                  <span class="font-bold text-ink">Total</span>
                  <span class="font-bold text-primary"
                        id="summaryTotal"
                        data-subtotal="<%= totalPrice %>">
                    Rp <%= Number(totalPrice).toLocaleString('id-ID') %>
                  </span>
                </div>
              </div>

              <button id="btnCheckout"
                      class="mt-6 w-full h-12 rounded-xl bg-primary text-white font-bold tracking-wide hover:bg-primarydark transition disabled:opacity-60 disabled:cursor-not-allowed">
                CHECKOUT
              </button>

              <p class="mt-3 text-[11px] text-body text-center">
                Pembayaran diproses aman oleh Midtrans
              </p>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script
  src="<%= midtransIsProduction ? 'https://app.midtrans.com/snap/snap.js' : 'https://app.sandbox.midtrans.com/snap/snap.js' %>"
  data-client-key="<%= midtransClientKey %>">
</script>

<!-- ================= SCRIPT: QTY AUTO-UPDATE ================= -->
<script>
(function () {
  const DEBOUNCE_MS = 500;
  const timers = new Map();
  const rupiah = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');

  async function pushQty(row, qty) {
    const id = row.dataset.id;
    const stock = Number(row.dataset.stock);

    if (qty < 1) qty = 1;
    if (stock > 0 && qty > stock) qty = stock;

    const input = row.querySelector('.qty-input');
    if (input) input.value = qty;

    try {
      const res = await fetch('/cart/set', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_product: id, quantity: qty })
      });
      const data = await res.json();

      if (!data.success) {
        alert(data.message || 'Gagal update cart');
        return;
      }

      const price = Number(row.dataset.price);
      const subtotalEl = row.querySelector('.subtotal');
      if (subtotalEl) subtotalEl.textContent = rupiah(price * qty);

      const sumItems = document.getElementById('summaryTotalItems');
      const sumSub = document.getElementById('summarySubtotal');
      const sumTot = document.getElementById('summaryTotal');

      if (sumItems) sumItems.textContent = data.totalItems;
      if (sumSub) sumSub.textContent = rupiah(data.totalPrice);
      if (sumTot) {
        sumTot.dataset.subtotal = data.totalPrice;
        if (window.__updateGrandTotal) window.__updateGrandTotal();
      }

      const badge = document.querySelector('#site-header a[aria-label="Shopping cart"] span');
      if (badge) {
        badge.textContent = data.totalItems;
        if (data.totalItems === 0) badge.style.display = 'none';
      }

      if (window.__resetShipping) window.__resetShipping();
    } catch (err) {
      console.error(err);
      alert('Gagal update cart');
    }
  }

  function schedulePush(row, qty) {
    const id = row.dataset.id;
    clearTimeout(timers.get(id));
    timers.set(id, setTimeout(() => pushQty(row, qty), DEBOUNCE_MS));
  }

  document.querySelectorAll('.cart-row').forEach((row) => {
    const input = row.querySelector('.qty-input');

    row.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = parseInt(input.value, 10) || 1;
        const next = btn.dataset.action === 'inc' ? current + 1 : current - 1;
        schedulePush(row, next);
      });
    });

    input.addEventListener('input', () => {
      const v = parseInt(input.value, 10);
      if (Number.isNaN(v)) return;
      schedulePush(row, v);
    });

    input.addEventListener('blur', () => {
      const v = parseInt(input.value, 10);
      if (!Number.isNaN(v)) pushQty(row, v);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        pushQty(row, parseInt(input.value, 10) || 1);
      }
    });
  });

  document.querySelectorAll('.remove-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('.cart-row');
      const id = row.dataset.id;

      const res = await fetch('/cart/set', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_product: id, quantity: 0 })
      });
      const data = await res.json();

      if (data.success) {
        row.remove();

        if (data.totalItems === 0) {
          window.location.reload();
          return;
        }

        const sumItems = document.getElementById('summaryTotalItems');
        const sumSub = document.getElementById('summarySubtotal');
        const sumTot = document.getElementById('summaryTotal');
        if (sumItems) sumItems.textContent = data.totalItems;
        if (sumSub) sumSub.textContent = rupiah(data.totalPrice);
        if (sumTot) {
          sumTot.dataset.subtotal = data.totalPrice;
          if (window.__updateGrandTotal) window.__updateGrandTotal();
        }

        const badge = document.querySelector('#site-header a[aria-label="Shopping cart"] span');
        if (badge) badge.textContent = data.totalItems;

        if (window.__resetShipping) window.__resetShipping();
      }
    });
  });
})();
</script>

<!-- ================= SCRIPT: SHIPPING (PROVINSI → KOTA → KECAMATAN) ================= -->
<script>
(function () {
  // Kurir aktif di akun Komerce
  const ALL_COURIERS = [
    'jne', 'sicepat', 'ide', 'sap', 'ninja', 'jnt', 'tiki',
    'wahana', 'pos', 'sentral', 'lion', 'rex', 'spx'
  ].join(':');

  const provinceSelect = document.getElementById('province');
  const citySelect = document.getElementById('city');
  const districtSelect = document.getElementById('district');
  const btnCek = document.getElementById('btnCekOngkir');
  const shippingResult = document.getElementById('shippingResult');
  const shippingList = document.getElementById('shippingList');
  const shippingCostLabel = document.getElementById('shippingCostLabel');
  const totalWeightLabel = document.getElementById('totalWeightLabel');

  if (!provinceSelect || !citySelect || !districtSelect) return;

  let selectedService = {
    courier: '',
    courierName: '',
    service: '',
    cost: 0
  };

  const rupiah = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');

  // ---------- Load provinsi ----------
  fetch('/api/shipping/provinces')
    .then(r => r.json())
    .then(res => {
      provinceSelect.innerHTML = '<option value="">Pilih Provinsi</option>';

      if (!res.success) {
        console.error('[SHIPPING] provinsi error:', res.message);
        provinceSelect.innerHTML = '<option value="">Gagal: ' + (res.message || 'Unknown') + '</option>';
        return;
      }

      res.data.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = p.name;
        provinceSelect.appendChild(opt);
      });

      const saved = provinceSelect.dataset.saved;
      if (saved) {
        provinceSelect.value = saved;
        provinceSelect.dispatchEvent(new Event('change'));
      }
    })
    .catch(err => {
      console.error('[SHIPPING] provinsi fetch error:', err);
      provinceSelect.innerHTML = '<option value="">Network error</option>';
    });

  // ---------- Province → Cities ----------
  provinceSelect.addEventListener('change', function () {
    const provinceId = this.value;
    citySelect.innerHTML = '<option value="">Memuat kota...</option>';
    districtSelect.innerHTML = '<option value="">Pilih Kecamatan</option>';

    if (!provinceId) {
      citySelect.innerHTML = '<option value="">Pilih Kota</option>';
      return;
    }

    fetch('/api/shipping/cities/' + provinceId)
      .then(r => r.json())
      .then(res => {
        citySelect.innerHTML = '<option value="">Pilih Kota/Kabupaten</option>';

        if (!res.success) {
          console.error('[SHIPPING] kota error:', res.message);
          citySelect.innerHTML = '<option value="">Gagal: ' + (res.message || 'Unknown') + '</option>';
          return;
        }

        res.data.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name;
          citySelect.appendChild(opt);
        });

        const saved = citySelect.dataset.saved;
        if (saved) {
          citySelect.value = saved;
          citySelect.dispatchEvent(new Event('change'));
        }
      })
      .catch(err => {
        console.error('[SHIPPING] kota fetch error:', err);
        citySelect.innerHTML = '<option value="">Network error</option>';
      });
  });

  // ---------- City → Districts ----------
  citySelect.addEventListener('change', function () {
    const cityId = this.value;
    districtSelect.innerHTML = '<option value="">Memuat kecamatan...</option>';

    if (!cityId) {
      districtSelect.innerHTML = '<option value="">Pilih Kecamatan</option>';
      return;
    }

    fetch('/api/shipping/districts/' + cityId)
      .then(r => r.json())
      .then(res => {
        districtSelect.innerHTML = '<option value="">Pilih Kecamatan</option>';

        if (!res.success) {
          console.error('[SHIPPING] kecamatan error:', res.message);
          districtSelect.innerHTML = '<option value="">Gagal: ' + (res.message || 'Unknown') + '</option>';
          return;
        }

        res.data.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id;
          opt.textContent = d.name + (d.zip_code && d.zip_code !== '0' ? ' (' + d.zip_code + ')' : '');
          opt.dataset.postal = d.zip_code || '';
          districtSelect.appendChild(opt);
        });

        const saved = districtSelect.dataset.saved;
        if (saved) {
          districtSelect.value = saved;
          districtSelect.dispatchEvent(new Event('change'));
        }
      })
      .catch(err => {
        console.error('[SHIPPING] kecamatan fetch error:', err);
        districtSelect.innerHTML = '<option value="">Network error</option>';
      });
  });

  // ---------- District change → autofill zip code ----------
  districtSelect.addEventListener('change', function () {
    const selected = this.options[this.selectedIndex];
    if (selected && selected.dataset.postal) {
      const postalInput = document.getElementById('postal_code');
      if (postalInput) postalInput.value = selected.dataset.postal;
    }
    resetShipping();
  });

  // ---------- Cek ongkir ----------
  if (btnCek) {
    btnCek.addEventListener('click', async function () {
      const destination = districtSelect.value;

      if (!destination) { alert('Pilih kecamatan terlebih dahulu'); return; }

      btnCek.disabled = true;
      const originalText = btnCek.textContent;
      btnCek.textContent = 'MENGHITUNG SEMUA KURIR...';

      try {
        const res = await fetch('/api/shipping/cost', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            destination,
            courier: ALL_COURIERS
          })
        });
        const data = await res.json();

        if (!data.success) {
          alert(data.message || 'Gagal cek ongkir');
          return;
        }

        if (!data.costs || data.costs.length === 0) {
          alert('Tidak ada layanan tersedia untuk rute ini');
          return;
        }

        if (totalWeightLabel) {
          totalWeightLabel.textContent = Number(data.total_weight || 0).toLocaleString('id-ID');
        }

        renderShippingList(data.costs);
        shippingResult.classList.remove('hidden');
      } catch (err) {
        console.error('Cek ongkir error:', err);
        alert('Terjadi kesalahan saat cek ongkir');
      } finally {
        btnCek.disabled = false;
        btnCek.textContent = originalText;
      }
    });
  }

  // ---------- Render daftar layanan ----------
  function renderShippingList(costs) {
    shippingList.innerHTML = '';

    const sorted = [...costs].sort((a, b) => Number(a.cost) - Number(b.cost));

    sorted.forEach(function (c, idx) {
      const courierName = c.name || c.code || 'Kurir';
      const serviceName = c.service || '-';
      const cost = Number(c.cost) || 0;
      const etd = c.etd || '-';

      const label = document.createElement('label');
      label.className = 'shipping-item block cursor-pointer';
      label.innerHTML = `
        <input type="radio" name="shipping_service" value="${idx}"
               class="peer sr-only"
               data-courier="${c.code || ''}"
               data-courier-name="${courierName}"
               data-service="${serviceName}"
               data-cost="${cost}">

        <div class="flex items-center justify-between p-3 rounded-xl border border-gray-200 bg-white
                    hover:border-primary/60 hover:bg-primary/5
                    peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:ring-2 peer-checked:ring-primary/30
                    transition">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-xs font-bold text-ink shrink-0">
              ${escapeHtml(courierName.slice(0, 4).toUpperCase())}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink truncate">${escapeHtml(courierName)} — ${escapeHtml(serviceName)}</p>
              <p class="text-xs text-body">Estimasi: ${escapeHtml(etd)}</p>
            </div>
          </div>
          <div class="text-right shrink-0 ml-2">
            <p class="text-sm font-bold text-primary">${rupiah(cost)}</p>
          </div>
        </div>
      `;

      shippingList.appendChild(label);
    });

    const firstRadio = shippingList.querySelector('input[type="radio"]');
    if (firstRadio) {
      firstRadio.checked = true;
      firstRadio.dispatchEvent(new Event('change'));
    }

    shippingList.querySelectorAll('input[type="radio"]').forEach(r => {
      r.addEventListener('change', function () {
        if (!this.checked) return;
        selectedService = {
          courier: this.dataset.courier,
          courierName: this.dataset.courierName,
          service: this.dataset.service,
          cost: Number(this.dataset.cost) || 0
        };
        if (shippingCostLabel) shippingCostLabel.textContent = rupiah(selectedService.cost);
        updateGrandTotal();
      });
    });
  }

  function escapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, (m) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
  }

  function updateGrandTotal() {
    const subtotalEl = document.getElementById('summaryTotal');
    const shippingEl = document.getElementById('summaryShipping');

    if (!subtotalEl) return;

    const subtotal = Number(subtotalEl.dataset.subtotal || 0);
    const total = subtotal + selectedService.cost;

    if (shippingEl) shippingEl.textContent = rupiah(selectedService.cost);
    subtotalEl.textContent = rupiah(total);
  }

  function resetShipping() {
    selectedService = { courier: '', courierName: '', service: '', cost: 0 };
    if (shippingResult) shippingResult.classList.add('hidden');
    if (shippingCostLabel) shippingCostLabel.textContent = 'Rp 0';
    if (shippingList) shippingList.innerHTML = '';
    const shipEl = document.getElementById('summaryShipping');
    if (shipEl) shipEl.textContent = 'Rp 0';
    updateGrandTotal();
  }

  window.__updateGrandTotal = updateGrandTotal;
  window.__resetShipping = resetShipping;

  // ================================================================
  // CHECKOUT
  // ================================================================
  const btnCheckout = document.getElementById('btnCheckout');
  if (btnCheckout) {
    btnCheckout.addEventListener('click', async function () {
      const recipient = document.getElementById('recipient_name').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const address = document.getElementById('address').value.trim();
      const provinceId = provinceSelect.value;
      const cityId = citySelect.value;
      const districtId = districtSelect.value;
      const postalCode = document.getElementById('postal_code').value.trim();
      const email = document.getElementById('email').value.trim();

      if (!recipient) { alert('Nama penerima wajib diisi'); return; }
      if (!phone) { alert('No. telepon wajib diisi'); return; }
      if (!address) { alert('Alamat wajib diisi'); return; }
      if (!provinceId) { alert('Provinsi wajib dipilih'); return; }
      if (!cityId) { alert('Kota wajib dipilih'); return; }
      if (!districtId) { alert('Kecamatan wajib dipilih'); return; }
      if (!selectedService.courier) { alert('Klik "CEK ONGKIR" terlebih dahulu'); return; }

      btnCheckout.disabled = true;
      const originalText = btnCheckout.textContent;
      btnCheckout.textContent = 'MEMPROSES...';

      try {
        const shipRes = await fetch('/cart/shipping', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recipient_name: recipient,
            phone,
            email,
            address,
            city_id: cityId,
            city_name: citySelect.options[citySelect.selectedIndex].textContent,
            district_id: districtId,
            district_name: districtSelect.options[districtSelect.selectedIndex].textContent,
            province_id: provinceId,
            province_name: provinceSelect.options[provinceSelect.selectedIndex].textContent,
            postal_code: postalCode,
            courier: selectedService.courier,
            courier_service: selectedService.service,
            shipping_cost: selectedService.cost
          })
        });

        const shipData = await shipRes.json();
        if (!shipData.success) {
          alert(shipData.message || 'Gagal simpan data penerima');
          btnCheckout.disabled = false;
          btnCheckout.textContent = originalText;
          return;
        }

        const res = await fetch('/cart/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });

        const data = await res.json();

        if (!data.success) {
          alert(data.message || 'Gagal membuat transaksi');
          btnCheckout.disabled = false;
          btnCheckout.textContent = originalText;
          return;
        }

        window.snap.pay(data.token, {
          onSuccess: function () {
            window.location.href = '/cart/success?order_id=' + data.order_id;
          },
          onPending: function () {
            alert('Pembayaran menunggu. Selesaikan sesuai instruksi.');
            window.location.href = '/cart/success?order_id=' + data.order_id;
          },
          onError: function () {
            alert('Pembayaran gagal.');
            btnCheckout.disabled = false;
            btnCheckout.textContent = originalText;
          },
          onClose: function () {
            btnCheckout.disabled = false;
            btnCheckout.textContent = originalText;
          }
        });
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan.');
        btnCheckout.disabled = false;
        btnCheckout.textContent = originalText;
      }
    });
  }
})();
</script>

