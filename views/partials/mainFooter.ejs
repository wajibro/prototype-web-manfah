<!-- ================= AUTO ACTIVE NAV ================= -->
<script>
(function () {
  // Normalisasi path: buang trailing slash (kecuali root "/")
  const normalize = (p) => {
    if (!p) return '/';
    p = p.replace(/\/+$/, '');
    return p === '' ? '/' : p.toLowerCase();
  };

  const current = normalize(window.location.pathname);

  // Ambil semua link navbar (desktop & mobile)
  const links = document.querySelectorAll(
    '#site-header a.nav-link, #site-header a.nav-link-home'
  );

  links.forEach((link) => {
    const raw = link.getAttribute('href') || '';
    if (raw.startsWith('#') || raw === '') return; // skip anchor/empty

    let target;
    try {
      target = normalize(new URL(raw, window.location.origin).pathname);
    } catch (e) { return; }

    // Cocokkan exact ATAU root untuk "/"
    const isHome = target === '/' && current === '/';
    const isMatch = target === current;

    if (isHome || isMatch) {
      link.setAttribute('aria-current', 'page');
    } else {
      link.removeAttribute('aria-current');
    }
  });
})();
</script>

<!-- ================= SCROLL REVEAL SCRIPT ================= -->
<script>
(function () {
  var els = document.querySelectorAll('[data-reveal]');
  if (!els.length) return;

  if (!('IntersectionObserver' in window)) {
    els.forEach(function (el) { el.classList.add('is-visible'); });
    return;
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;

      var el = entry.target;
      var delay = parseInt(el.getAttribute('data-reveal-delay') || '0', 12);

      window.setTimeout(function () {
        el.classList.add('is-visible');
      }, delay);

      observer.unobserve(el);
    });
  }, {
    threshold: 0.12,
    rootMargin: '0px 0px -60px 0px'
  });

  els.forEach(function (el) { observer.observe(el); });
})();
</script>

<script>
  // Mobile menu toggle
  document.getElementById('menu-btn').addEventListener('click', function () {
    document.getElementById('mobile-menu').classList.toggle('hidden');
  });

  // Header scroll effect & Logo swap
  const header = document.getElementById('site-header');
  const logoImg = document.getElementById('logo-img');

  const whiteLogo = 'https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/manfah_white.png';
  const grayLogo = 'https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/manfah_gray.png';

  function handleScroll() {
    if (window.scrollY > 10) {
      header.classList.add('scrolled', 'bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-100');
      header.classList.remove('bg-transparent');
      logoImg.src = grayLogo;
    } else {
      header.classList.remove('scrolled', 'bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-100');
      header.classList.add('bg-transparent');
      logoImg.src = whiteLogo;
    }
  }

  window.addEventListener('scroll', handleScroll);
  window.addEventListener('load', handleScroll);
</script>

