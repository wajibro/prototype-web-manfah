}
</script>
<%
  const _bg = {
    image: (typeof bgImage !== 'undefined' && bgImage) ? bgImage : ''
  };
%>
<style>
  html { scroll-behavior: smooth; }
  body { 
    font-family: 'Poppins', sans-serif;
    background-image: url('<%- _bg.image %>'); 
  }

  /* ====== NAV LINK – STATE DASAR (REDUP) ====== */
  .nav-link,
  .nav-link-home {
    position: relative;
    border-radius: 0.5rem;
    transition: color .3s ease,
                background-color .3s ease,
                text-shadow .3s ease;
  }

  /* ====== STATE 1: HEADER TRANSPARAN (belum scroll) ====== */
  /* Redup: putih dengan opacity 70% */
  #site-header:not(.scrolled) .nav-link,
  #site-header:not(.scrolled) .nav-link-home {
    color: rgba(255, 255, 255, 0.7);
    text-shadow: none;
  }

  /* Hover: putih penuh + glow putih */
  #site-header:not(.scrolled) .nav-link:hover,
  #site-header:not(.scrolled) .nav-link-home:hover {
    color: #ffffff;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.85),
                 0 0 24px rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.08);
  }

  /* Aktif: sama seperti hover, permanen */
  #site-header:not(.scrolled) .nav-link[aria-current="page"],
  #site-header:not(.scrolled) .nav-link-home[aria-current="page"] {
    color: #ffffff;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.85),
                 0 0 24px rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.08);
  }

  /* ====== STATE 2: HEADER PUTIH (setelah scroll) ====== */
  /* Redup: slate-500 */
  #site-header.scrolled .nav-link,
  #site-header.scrolled .nav-link-home {
    color: #64748b; /* slate-500 */
    text-shadow: none;
  }

  /* Hover: primary + glow ungu */
  #site-header.scrolled .nav-link:hover,
  #site-header.scrolled .nav-link-home:hover {
    color: #5B38ED;
    text-shadow: 0 0 12px rgba(91, 56, 237, 0.55),
                 0 0 22px rgba(91, 56, 237, 0.25);
    background-color: #F3F5F7; /* softer */
  }

  /* Aktif: permanen menyala */
  #site-header.scrolled .nav-link[aria-current="page"],
  #site-header.scrolled .nav-link-home[aria-current="page"] {
    color: #5B38ED;
    text-shadow: 0 0 12px rgba(91, 56, 237, 0.55),
                 0 0 22px rgba(91, 56, 237, 0.25);
    background-color: #F3F5F7;
  }

  /* ====== HEADER ICON (search/account/cart/hamburger) ====== */
  #site-header:not(.scrolled) .header-icon { color: rgba(255,255,255,0.75); }
  #site-header:not(.scrolled) .header-icon:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
    text-shadow: 0 0 10px rgba(255,255,255,0.7);
  }

  #site-header.scrolled .header-icon { color: #64748b; }
  #site-header.scrolled .header-icon:hover {
    color: #5B38ED;
    background-color: #F3F5F7;
  }

  /* ====== DROPDOWN ====== */
  .dropdown-link {
    color: #64748b; /* redup default */
    transition: color .2s, background-color .2s, text-shadow .2s;
  }
  .dropdown-link:hover {
    color: #5B38ED;
    background-color: #F3F5F7;
    text-shadow: 0 0 10px rgba(91, 56, 237, 0.4);
  }
  .dropdown-link[aria-current="page"] {
    color: #5B38ED;
    background-color: #F3F5F7;
    text-shadow: 0 0 10px rgba(91, 56, 237, 0.4);
  }
</style>
<!-- ================= SCROLL REVEAL STYLES ================= -->
<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: opacity, transform;
  }
  [data-reveal="left"]   { transform: translateX(-36px); }
  [data-reveal="right"]  { transform: translateX(36px); }
  [data-reveal="zoom"]   { transform: scale(0.94); }
  [data-reveal="fade"]   { transform: none; }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
<style>
  /* ---------- HEADING ANCHOR SCROLL OFFSET ---------- */
.prose-blog h1,
.prose-blog h2,
.prose-blog h3 {
    scroll-margin-top: 100px;    /* biar tidak ketutup navbar saat klik TOC */
}

/* ---------- CODE BLOCK ---------- */
.code-block {
    margin: 1.5rem 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #1f2937;
    background: #0d1117;
}

.code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    font-size: 0.75rem;
    color: #8b949e;
}

.code-lang {
    text-transform: uppercase;
    font-weight: 700;
}

.copy-btn {
    background: transparent;
    border: 1px solid #30363d;
    color: #8b949e;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.7rem;
    cursor: pointer;
}

.copy-btn:hover {
    background: #21262d;
    color: #f0f6fc;
}

.code-block pre {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
}

.code-block pre code {
    background: transparent;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e6edf3;
}

.inline-code {
    background: #f3f4f6;
    color: #dc2626;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.875em;
}
</style>
<style>
  /* ==========================================================
   TOC BOX — persis seperti gambar
   ========================================================== */
.toc-box {
    background: #ffffff;
    border: 1px solid #d1d5db;           /* abu tipis */
    border-radius: 8px;
    padding: 1.75rem 2rem;
    margin: 1.5rem 0 2rem;
    max-width: 100%;
}

/* Judul TOC = heading h2 tepat sebelum .toc-box */
.prose-blog h2:has(+ .toc-box),
.prose-blog h2 + .toc-box + h2,
.prose-blog h2:first-child {
    /* override border-bottom default di h2 kalau ada */
    border-bottom: none;
    padding-bottom: 0;
}

/* Fallback: kalau heading "Table Of Contents" adalah h2 pertama */
.prose-blog .toc-box {
    margin-top: 0.5rem;
}

/* Judul di atas TOC (dari markdown ## Table Of Contents) */
.prose-blog > h2:first-child,
.prose-blog > h2:has(+ .toc-box) {
    font-size: 1.25rem;
    font-weight: 500;
    color: #4b5563;                       /* abu medium */
    margin: 1rem 0 0.75rem;
    border-bottom: none;
    padding-bottom: 0;
}

/* List dalam TOC */
.toc-list {
    list-style: disc !important;
    margin: 0 !important;
    padding-left: 1.5rem !important;
}

.toc-list li {
    margin: 0.5rem 0 !important;
    padding-left: 0.25rem !important;
    color: #6b7280;
}

.toc-list li::marker {
    color: #6b7280;                       /* bullet abu */
    font-size: 0.9em;
}

/* Link TOC — biru gelap dengan underline */
.toc-list a,
.toc-box a {
    color: #1e3a5f !important;            /* biru navy gelap */
    text-decoration: underline !important;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: #9ca3af;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.15s, text-decoration-color 0.15s;
}

.toc-list a:hover,
.toc-box a:hover {
    color: #0c2340 !important;
    text-decoration-color: #1e3a5f;
}
</style>
</head>

