<%- include('partials/mainHeader', { bgImage: cover_url }); %>

<main>
    <!-- ================= HERO ================= -->
    <section class="relative overflow-hidden h-[300px] lg:h-[350px] flex items-center justify-center">
        <!-- Background dari cover_url -->
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
        <div class="absolute inset-0 bg-black/50"></div>

        <!-- Konten Hero -->
        <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
            <h1 class="mt-2 text-3xl lg:text-5xl font-bold leading-tight text-white"
                data-reveal data-reveal-delay="120">
                <%= title %>
            </h1>

            <p class="mt-3 text-xs lg:text-base font-medium tracking-wider uppercase text-white/90"
               data-reveal data-reveal-delay="0">
                <%= creator.nama %> /
                <%= new Date(date).toLocaleDateString('id-ID', {
                    day: 'numeric', month: 'long', year: 'numeric'
                }) %> /
                <%= (kategori || []).slice(0, 2).join(', ') %><% if ((kategori || []).length > 2) { %> +<%= kategori.length - 2 %><% } %>
            </p>
        </div>
    </section>

    <!-- ================= KONTEN ================= -->
     <div class="bg-white">
        <article class="max-w-3xl mx-auto px-4 lg:px-0 py-8">
            <!-- Konten Markdown -->
            <div class="blog-content prose prose-lg max-w-none">
                <%- content %>
            </div>
        </article>
    </div>
</main>

<%- include('partials/mainFooter'); %>