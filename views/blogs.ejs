<%- include('partials/mainHeader', {
    bgImage: "https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/photo-1517420704952-d9f39e95b43e.avif"
});%>

<%
  const isSearchMode = typeof query !== 'undefined' && query.q && String(query.q).trim() !== '';

  // ---------- Helper: format date for input[type=date] ----------
  const formatDateForInput = (val) => {
    if (!val) return '';
    const d = new Date(val);
    if (isNaN(d.getTime())) return String(val).slice(0, 10);
    return d.toISOString().split('T')[0];
  };

  // ---------- Helper: build query string preserving existing params ----------
  const buildQueryString = (overrides = {}) => {
    const params = new URLSearchParams();
    const currentQuery = (typeof query !== 'undefined' && query) ? query : {};
    for (const key in currentQuery) {
      if (!Object.prototype.hasOwnProperty.call(currentQuery, key)) continue;
      if (overrides.hasOwnProperty(key)) continue;
      const val = currentQuery[key];
      if (val !== undefined && val !== null && val !== '') {
        params.set(key, val);
      }
    }
    for (const key in overrides) {
      if (overrides[key] !== undefined && overrides[key] !== null && overrides[key] !== '') {
        params.set(key, overrides[key]);
      }
    }
    return params.toString();
  };

  // ---------- Derive available months from dates ----------
  const monthLabels = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const monthSet = new Set();
  (typeof dates !== 'undefined' && dates ? dates : []).forEach(d => {
    const val = d.value || d.tanggal || d;
    if (val && typeof val === 'string') {
      const dt = new Date(val);
      if (!isNaN(dt.getTime())) {
        const key = `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}`;
        monthSet.add(key);
      }
    }
  });
  const availableMonths = Array.from(monthSet).sort().reverse();
  const formatMonthLabel = (m) => {
    const [y, mo] = m.split('-').map(Number);
    return `${monthLabels[mo - 1]} ${y}`;
  };
%>

<main>
  <!-- ================= HERO / BANNER ================= -->
  <section class="relative overflow-hidden h-[300px] lg:h-[300px] flex items-center justify-center">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
    <div class="absolute inset-0 bg-black/50"></div>

    <div class="relative z-10 text-center text-white px-4">
      <p class="text-xs lg:text-base font-medium tracking-wider uppercase text-white/90" data-reveal data-reveal-delay="0">
        <a href="/" class="text-white/50 hover:text-white/90">Home</a> / Blog
      </p>
      <h1 class="mt-2 text-5xl lg:text-6xl font-bold leading-tight text-white" data-reveal data-reveal-delay="120">
        Blog
      </h1>
    </div>
  </section>

  <!-- Wrapper full-width untuk background putih -->
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

      <!-- ================= FILTER / SEARCH SECTION (ANIMATED) ================= -->
      <div class="mb-12" data-reveal data-reveal-delay="200">

        <div class="flex justify-center">
          <div id="filterBar" class="relative w-full max-w-5xl min-h-[68px] rounded-full shadow-lg border border-gray-200 bg-white">

            <!-- ============ VIEW 1: FILTERS ============ -->
            <form id="filtersView" action="" method="GET"
              class="w-full h-full p-1.5 flex flex-col md:flex-row items-center gap-2 md:gap-0 transition-all duration-300 ease-out
                     <%= isSearchMode ? 'opacity-0 -translate-y-3 pointer-events-none' : '' %>">

              <!-- Bawa keyword search saat ganti dropdown -->
              <% if (typeof query !== 'undefined' && query.q) { %>
                <input type="hidden" name="q" value="<%= query.q %>">
              <% } %>

              <!-- Filter Kategori -->
              <div class="flex-1 w-full px-4 flex flex-col justify-center">
                <label for="kategori" class="text-[10px] font-bold text-gray-800 uppercase tracking-wider">Kategori</label>
                <select name="kategori" id="kategori"
                  onchange="this.form.submit()"
                  class="text-sm text-gray-600 bg-transparent border-none outline-none focus:ring-0 cursor-pointer w-full py-0.5"
                >
                  <option value="">Filter</option>
                  <% if (typeof categories !== 'undefined' && categories && categories.length) { %>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.kategori %>"
                        <%= (typeof query !== 'undefined' && String(query.kategori) === String(cat.kategori)) ? 'selected' : '' %>>
                        <%= cat.kategori %>
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <!-- Divider -->
              <div class="hidden md:block w-px h-10 bg-gray-300 mx-2"></div>

              <!-- Filter Tanggal & Bulan -->
              <div class="flex-1 w-full px-4 flex flex-col justify-center">
                <label class="text-[10px] font-bold text-gray-800 uppercase tracking-wider">Tanggal &amp; Bulan</label>
                <div class="flex items-center gap-2">
                  <input type="date" name="tanggal" id="tanggal" list="availableDates"
                    value="<%= (typeof query !== 'undefined' && query.tanggal) ? formatDateForInput(query.tanggal) : '' %>"
                    onchange="document.getElementById('bulan').value=''; this.form.submit()"
                    class="text-sm text-gray-600 bg-transparent border-none outline-none focus:ring-0 cursor-pointer w-full py-0.5">
                  <select name="bulan" id="bulan"
                    onchange="document.getElementById('tanggal').value=''; this.form.submit()"
                    class="text-sm text-gray-600 bg-transparent border-none outline-none focus:ring-0 cursor-pointer w-full py-0.5">
                    <option value="">Bulan</option>
                    <% availableMonths.forEach(m => { %>
                      <option value="<%= m %>" <%= (typeof query !== 'undefined' && String(query.bulan) === m) ? 'selected' : '' %>>
                        <%= formatMonthLabel(m) %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <datalist id="availableDates">
                  <% (typeof dates !== 'undefined' ? dates : []).forEach(date => { %>
                    <% const val = formatDateForInput(date.value || date.tanggal || date); %>
                    <option value="<%= val %>"><%= date.label || date.tanggal || date %></option>
                  <% }); %>
                </datalist>
              </div>

              <!-- Divider -->
              <div class="hidden md:block w-px h-10 bg-gray-300 mx-2"></div>

              <!-- Filter Kreator -->
              <div class="flex-1 w-full px-4 flex flex-col justify-center">
                <label for="kreator" class="text-[10px] font-bold text-gray-800 uppercase tracking-wider">Kreator</label>
                <select name="kreator" id="kreator"
                  onchange="this.form.submit()"
                  class="text-sm text-gray-600 bg-transparent border-none outline-none focus:ring-0 cursor-pointer w-full py-0.5"
                >
                  <option value="">Filter</option>
                  <% if (typeof creators !== 'undefined' && creators && creators.length) { %>
                    <% creators.forEach(creator => { %>
                      <option value="<%= creator.id_creator %>"
                        <%= (typeof query !== 'undefined' && String(query.kreator) === String(creator.id_creator)) ? 'selected' : '' %>>
                        <%= creator.nama %>
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <!-- Divider sebelum tombol search -->
              <div class="hidden md:block w-px h-10 bg-gray-300 mx-2"></div>

              <!-- Tombol buka Search -->
              <div class="pr-2 w-full md:w-auto flex justify-end">
                <button type="button" id="openSearchBtn"
                  class="bg-gray-100 hover:bg-gray-200 transition-colors rounded-full w-12 h-12 flex items-center justify-center text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </button>
              </div>
            </form>

            <!-- ============ VIEW 2: SEARCH ============ -->
            <form id="searchView" action="" method="GET"
              class="absolute inset-0 p-1.5 flex items-center gap-1 transition-all duration-300 ease-out
                     <%= isSearchMode ? 'opacity-100 scale-100' : 'opacity-0 scale-95 pointer-events-none' %>">

              <!-- Bawa filter aktif saat submit search -->
              <% if (typeof query !== 'undefined' && query.kategori) { %>
                <input type="hidden" name="kategori" value="<%= query.kategori %>">
              <% } %>
              <% if (typeof query !== 'undefined' && query.tanggal) { %>
                <input type="hidden" name="tanggal" value="<%= query.tanggal %>">
              <% } %>
              <% if (typeof query !== 'undefined' && query.bulan) { %>
                <input type="hidden" name="bulan" value="<%= query.bulan %>">
              <% } %>
              <% if (typeof query !== 'undefined' && query.kreator) { %>
                <input type="hidden" name="kreator" value="<%= query.kreator %>">
              <% } %>

              <!-- Tombol kembali -->
              <button type="button" id="closeSearchBtn"
                class="shrink-0 bg-gray-100 hover:bg-gray-200 transition-colors rounded-full w-12 h-12 flex items-center justify-center text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
              </button>

              <!-- Input pencarian -->
              <input type="text" name="q" id="searchInput" autocomplete="off"
                value="<%= (typeof query !== 'undefined' && query.q) ? query.q : '' %>"
                placeholder="Cari judul postingan, kreator, kategori..."
                class="flex-1 h-12 bg-transparent border-none outline-none focus:ring-0 text-gray-700 placeholder-gray-400 text-base px-3">
            </form>

          </div>
        </div>

      </div>
      <!-- ================= END FILTER / SEARCH SECTION ================= -->

      <!-- ================= BLOG GRID ================= -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <% posts.forEach((post, i) => { %>

          <div class="h-full" data-reveal data-reveal-delay="<%= (i % 3) * 120 %>">
            <article class="h-full bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-lg transition-shadow duration-300">

              <!-- Gambar Thumbnail -->
              <a href="<%= post.link %>" class="block overflow-hidden relative">
                <img src="<%= post.cover_url %>" alt="<%= post.judul %>" class="w-full h-56 object-cover transform hover:scale-105 transition-transform duration-500">
              </a>

              <div class="p-6 flex flex-col flex-grow">
                <!-- Kategori -->
                <div class="mb-2 text-sm">
                    <% if (post.kategori && post.kategori.length) { %>
                        <% post.kategori.forEach(function(k, i) { %>
                            <a href="https://manfahbot.cc/category/<%= (k.slug || k).toString().toLowerCase() %>/" class="hover:underline"><%= k.nama || k %></a><%= (i < post.kategori.length - 1) ? ', ' : '' %>
                        <% }); %>
                    <% } else { %>
                        <a href="https://manfahbot.cc/category/uncategorized/" class="hover:underline">Uncategorized</a>
                    <% } %>
                </div>

                <!-- Judul -->
                <h2 class="text-xl font-bold text-gray-900 mb-3 leading-snug">
                  <a href="<%= post.link %>" class="hover:text-blue-600 transition-colors">
                    <%= post.judul %>
                  </a>
                </h2>

                <% if (post.creator) { %>
                    <a href="/creator/<%= post.creator.slug %>/" class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-blue-600 transition-colors mb-3">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span><%= post.creator.nama %> | </span>
                        <span><%= formatTanggal(post.tanggal) %></span>
                    </a>
                <% } %>

                <!-- Excerpt -->
                <p class="text-gray-600 text-sm mb-6 flex-grow line-clamp-3">
                  <%= post.deskripsi_singkat %>...
                </p>

                <!-- Read More -->
                <a href="<%= post.link %>" class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800 transition-colors mt-auto">
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
              </div>
            </article>
          </div>

        <% }) %>

      </div>
    </div>
  </div>
</main>

<!-- ================= SCRIPTS ================= -->

<!-- 1) Toggle Search View + Auto focus + Close handling -->
<script>
  (function () {
    var openBtn     = document.getElementById('openSearchBtn');
    var closeBtn    = document.getElementById('closeSearchBtn');
    var filtersView = document.getElementById('filtersView');
    var searchView  = document.getElementById('searchView');
    var searchInput = document.getElementById('searchInput');

    if (!openBtn || !closeBtn || !filtersView || !searchView || !searchInput) return;

    function openSearch() {
      filtersView.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
      searchView.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      searchView.classList.add('opacity-100', 'scale-100');

      window.setTimeout(function () {
        searchInput.focus();
        var v = searchInput.value;
        searchInput.setSelectionRange(v.length, v.length);
      }, 150);
    }

    function closeSearch() {
      searchView.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      searchView.classList.remove('opacity-100', 'scale-100');
      filtersView.classList.remove('opacity-0', '-translate-y-3', 'pointer-events-none');
      searchInput.value = '';

      // Kalau ada ?q di URL, reload tanpa q supaya filter balik tampil
      var url = new URL(window.location.href);
      if (url.searchParams.has('q')) {
        url.searchParams.delete('q');
        window.location.href = url.toString();
      }
    }

    openBtn.addEventListener('click', openSearch);
    closeBtn.addEventListener('click', closeSearch);

    // Escape untuk menutup search
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !searchView.classList.contains('opacity-0')) {
        closeSearch();
      }
    });

    // Kalau server-side render dalam mode search, fokuskan input
    if (!searchView.classList.contains('opacity-0')) {
      searchInput.focus();
      var v = searchInput.value;
      searchInput.setSelectionRange(v.length, v.length);
    }
  })();
</script>

<!-- 2) Debounced auto-search -->
<script>
  (function () {
    var form  = document.getElementById('searchView');
    var input = document.getElementById('searchInput');
    if (!form || !input) return;

    var timer = null;
    var DELAY = 500; // ms — ubah sesuai selera (300–800)

    input.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () {
        form.submit();
      }, DELAY);
    });

    // Enter → submit langsung tanpa nunggu debounce
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        clearTimeout(timer);
        form.submit();
      }
    });
  })();
</script>

<%
  function formatTanggal(str) {
    if (!str) return '';
    const bulan = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    const d = new Date(str);
    const dd = String(d.getDate()).padStart(2, '0');
    const mmm = bulan[d.getMonth()];
    const yy = String(d.getFullYear()).slice(-2);
    return `${dd}, ${mmm} ${yy}`;
  }
%>

<%- include('partials/mainFooter') %>