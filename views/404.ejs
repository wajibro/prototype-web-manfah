<%- include('partials/mainHeader', {
  bgImage: "https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/photo-1517420704952-d9f39e95b43e.avif"
}); %>

<main>
  <section class="relative overflow-hidden min-h-[70vh] flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative z-10 text-center text-white px-4 max-w-xl mx-auto">
      <p class="text-6xl lg:text-8xl font-extrabold text-white/90">404</p>

      <h1 class="mt-4 text-2xl lg:text-3xl font-bold text-white">
        Halaman Tidak Ditemukan
      </h1>

      <p class="mt-3 text-sm lg:text-base text-white/80">
        <%= typeof message !== 'undefined' && message
              ? message
              : 'Halaman yang kamu cari tidak tersedia.' %>
      </p>

      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="/"
           class="inline-flex items-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-ink hover:bg-white/90 transition">
          Kembali ke Beranda
        </a>
        <a href="/blog"
           class="inline-flex items-center rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition">
          Lihat Blog
        </a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/mainFooter') %>