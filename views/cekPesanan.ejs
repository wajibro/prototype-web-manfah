<%- include('partials/mainHeader', {
  bgImage: "https://dkeswcdfflabksfaxdkk.supabase.co/storage/v1/object/public/bucket/assets/photo-1517420704952-d9f39e95b43e.avif"
}); %>

<main>
  <section class="relative overflow-hidden h-[260px] lg:h-[300px] flex items-center justify-center">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 text-center text-white px-4">
      <p class="text-xs lg:text-base font-medium tracking-wider uppercase text-white/90">
        <a href="/" class="text-white/50 hover:text-white/90">Home</a> / Cek Pesanan
      </p>
      <h1 class="mt-2 text-4xl lg:text-5xl font-bold text-white">Cek Pesanan</h1>
    </div>
  </section>

  <div class="bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

      <!-- Form -->
      <form method="GET" action="/cek-pesanan" class="mb-10">
        <label for="order_id" class="block text-sm font-semibold text-ink mb-2">Masukkan Order ID</label>
        <div class="flex gap-3">
          <input type="text" name="order_id" id="order_id" required
                 value="<%= orderId %>"
                 placeholder="Contoh: TRX-xxxxxxxxxxxxx-xxxx"
                 class="flex-1 h-12 rounded-xl border border-gray-200 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40">
          <button type="submit"
                  class="h-12 px-6 rounded-xl bg-primary text-white font-bold hover:bg-primarydark transition">
            Cek
          </button>
        </div>
      </form>

      <% if (notFound) { %>
        <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-center">
          <p class="text-red-600 font-semibold">Order ID "<%= orderId %>" tidak ditemukan.</p>
          <p class="mt-1 text-sm text-red-500">Periksa kembali Order ID kamu.</p>
        </div>
      <% } %>

      <% if (order) { %>
        <div class="space-y-8">

          <!-- Status Pembayaran -->
          <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-ink mb-4">Status Pembayaran</h2>
            <div class="grid sm:grid-cols-2 gap-3 text-sm">

              <!-- 1. Order ID -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Order ID</span>
                <span class="font-semibold text-ink"><%= order.order_id %></span>
              </div>

              <!-- 2. No. Resi (di bawah Order ID) -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">No. Resi</span>
                <span class="font-semibold text-ink font-mono">
                  <%= order.resi && order.resi !== '-' ? order.resi : '-' %>
                </span>
              </div>

              <!-- 3. Status -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Status</span>
                <span class="font-semibold text-ink uppercase"><%= order.status %></span>
              </div>

              <!-- 4. Status Pesanan (di bawah Status) -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Status Pesanan</span>
                <span class="font-semibold text-primary capitalize">
                  <%= order.status_order %>
                </span>
              </div>

              <!-- 5. Total -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Total</span>
                <span class="font-semibold text-primary">Rp <%= Number(order.gross_amount || 0).toLocaleString('id-ID') %></span>
              </div>

              <!-- 6. Metode Pembayaran -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Metode Pembayaran</span>
                <span class="font-semibold text-ink"><%= order.payment_type || '-' %></span>
              </div>

              <!-- 7. Transaction ID -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Transaction ID</span>
                <span class="font-semibold text-ink"><%= order.transaction_id || '-' %></span>
              </div>

              <!-- 8. Dibuat -->
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Dibuat</span>
                <span class="font-semibold text-ink"><%= order.created_at ? new Date(order.created_at).toLocaleString('id-ID') : '-' %></span>
              </div>

            </div>
          </div>
          <!-- Data Pengiriman -->
          <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-ink mb-4">Data Pengiriman</h2>
            <div class="grid sm:grid-cols-2 gap-3 text-sm">
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Nama Penerima</span>
                <span class="font-semibold text-ink"><%= order.shipping.recipient_name %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">No. Telepon</span>
                <span class="font-semibold text-ink"><%= order.shipping.phone %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2 sm:col-span-2">
                <span class="text-body">Email</span>
                <span class="font-semibold text-ink"><%= order.shipping.email %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2 sm:col-span-2">
                <span class="text-body">Alamat</span>
                <span class="font-semibold text-ink text-right"><%= order.shipping.address %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Kota/Kabupaten</span>
                <span class="font-semibold text-ink"><%= order.shipping.city_name || '-' %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Provinsi</span>
                <span class="font-semibold text-ink"><%= order.shipping.province_name || '-' %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Kode Pos</span>
                <span class="font-semibold text-ink"><%= order.shipping.postal_code || '-' %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Kurir</span>
                <span class="font-semibold text-ink"><%= order.shipping.courier ? order.shipping.courier.toUpperCase() : '-' %> - <%= order.shipping.courier_service || '-' %></span>
              </div>
              <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-body">Ongkir</span>
                <span class="font-semibold text-ink">Rp <%= Number(order.shipping.shipping_cost || 0).toLocaleString('id-ID') %></span>
              </div>
            </div>
          </div>

                    <!-- Items -->
          <% if (order.items && order.items.length) { %>
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <h2 class="text-lg font-bold text-ink mb-4">Item Pesanan</h2>
              <ul class="divide-y divide-gray-100">

                <% order.items.forEach(function(it) { %>
                  <li class="flex items-center gap-4 py-3">

                    <!-- Thumbnail -->
                    <div class="shrink-0 w-14 h-14 rounded-lg bg-softer overflow-hidden">
                      <% if (it.image_url) { %>
                        <img src="<%= it.image_url %>"
                             alt="<%= it.name %>"
                             class="w-full h-full object-cover">
                      <% } else { %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400 text-[10px]">
                          No Image
                        </div>
                      <% } %>
                    </div>

                    <!-- Nama + harga satuan -->
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold text-ink truncate">
                        <%= it.name %>
                      </p>
                      <p class="mt-0.5 text-xs text-body">
                        Rp <%= Number(it.price).toLocaleString('id-ID') %> × <%= it.quantity %>
                      </p>
                    </div>

                    <!-- Subtotal -->
                    <div class="text-right shrink-0">
                      <p class="text-sm font-bold text-primary">
                        Rp <%= Number(it.subtotal).toLocaleString('id-ID') %>
                      </p>
                    </div>

                  </li>
                <% }); %>

              </ul>
            </div>
          <% } %>

        </div>
      <% } %>

    </div>
  </div>
</main>

<%- include('partials/mainFooter') %>